# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.
# The app and every script in scripts/ read .env.local (scripts load it with dotenv).

# --- Supabase (required: the build prerenders pages from the database) ---
# Project Settings -> API in the Supabase dashboard. Also set both in Vercel
# (Production + Preview) and as GitHub Actions secrets for CI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: full database access, bypasses row-level security.
# Only scripts that write data need it. Keep it local; not needed in Vercel.
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps ---
# Browser key for the maps on the site (restrict it to your domains).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key for the data scripts (Places API + Geocoding API, no website restriction).
# Never the browser key above. .env.local only. Setup: docs/setup.md#google-server-key;
# check it with npm run google:check.
GOOGLE_MAPS_API_KEY=

# --- /api/sync and /api/revalidate ---
# Shared secret sent as the x-admin-token header. Same value in Vercel and in the
# GitHub Actions secret ADMIN_SYNC_TOKEN (used by .github/workflows/sync.yml).
ADMIN_SYNC_TOKEN=

# --- Contact form (/api/contact appends submissions to a Google Sheet) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key with literal \n line breaks
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SHEET_ID=

# --- Scripts only ---
# Yelp Fusion API key for scripts/fetch-yelp-reviews.ts
YELP_API_KEY=

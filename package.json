{
  "name": "marylandbrewery",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:clean": "rm -rf .next && next build",
    "start": "next start",
    "start:clean": "rm -rf .next && npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:links": "tsx scripts/validate-internal-links.ts",
    "lint:links:deployed": "linkinator https://www.marylandbrewery.com --recurse --skip 'maps.googleapis.com|google.com|facebook.com|instagram.com|twitter.com|yelp.com|untappd.com' --timeout 30000",
    "indexnow": "tsx scripts/submit-indexnow.ts",
    "format": "prettier --write .",
    "postinstall": "node scripts/ensure-lightningcss-binary.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:reviews:google": "tsx scripts/fetch-google-reviews.ts",
    "data:reviews:yelp": "tsx scripts/fetch-yelp-reviews.ts",
    "data:reviews:themes": "tsx scripts/analyze-and-store-review-themes.ts",
    "data:reviews:dedupe": "tsx scripts/remove-duplicate-reviews.ts",
    "data:reviews:counts": "tsx scripts/check-review-counts.ts",
    "data:news": "tsx scripts/fetch-brewery-news.ts",
    "data:logos": "tsx scripts/fetch-brewery-logos.ts",
    "data:photos": "tsx scripts/download-google-photos.ts",
    "data:geocode": "tsx scripts/geocode-breweries.ts",
    "data:verify-coordinates": "tsx scripts/verify-brewery-coordinates.ts",
    "data:enrich": "tsx scripts/enrich-supabase-breweries.ts",
    "data:enrich:amenities": "tsx scripts/enrich-amenities-from-reviews.ts",
    "data:attractions": "tsx scripts/fetch-maryland-attractions.ts",
    "seo:count-urls": "tsx scripts/count-sitemap-urls.ts"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2",
    "@supabase/supabase-js": "^2.81.1",
    "@vercel/analytics": "^1.3.0",
    "@vis.gl/react-google-maps": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.400.0",
    "next": "^15.5.9",
    "next-seo": "^6.8.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "rss-parser": "^3.13.0",
    "schema-dts": "^1.1.5",
    "tailwind-merge": "^3.3.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.0",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/selenium-webdriver": "^4.35.4",
    "@types/xml2js": "^0.4.14",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.9",
    "lightningcss": "^1.33.0",
    "linkinator": "^7.5.3",
    "playwright": "^1.56.1",
    "prettier": "^3.3.0",
    "selenium-webdriver": "^4.39.0",
    "sharp": "^0.34.5",
    "supabase": "^2.70.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
